{
  "info": {
    "name": "YuTu – MongoDB (ЛР6)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Вход",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@yutu.local\",\n  \"password\": \"User123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('token', pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET список постов",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/posts?limit=5"
      }
    },
    {
      "name": "POST создать пост",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/posts",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"MongoDB в блоге\",\n  \"content\": \"Пост хранится одним документом вместе с тегами и комментариями\",\n  \"tags\": [\n    \"mongodb\",\n    \"nosql\"\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('postId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET пост по id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/posts/{{postId}}"
      }
    },
    {
      "name": "PUT обновить пост",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/posts/{{postId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"MongoDB в блоге (обновлено)\",\n  \"content\": \"Документная модель: пост, теги и комментарии в одном документе\"\n}"
        }
      }
    },
    {
      "name": "POST добавить комментарий ($push)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/posts/{{postId}}/comments",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Отличный пример вложенного документа\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('commentId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH лайк комментария ($inc + $)",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/posts/{{postId}}/comments/{{commentId}}/like"
      }
    },
    {
      "name": "POST добавить тег ($addToSet)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/posts/{{postId}}/tags",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tag\": \"atlas\"\n}"
        }
      }
    },
    {
      "name": "POST оценить пост",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/posts/{{postId}}/rate",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rating\": 5\n}"
        }
      }
    },
    {
      "name": "GET посты по тегу",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/posts/tag/mongodb"
      }
    },
    {
      "name": "GET статистика (aggregate)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/posts/stats"
      }
    },
    {
      "name": "DELETE удалить комментарий ($pull)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/posts/{{postId}}/comments/{{commentId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "DELETE удалить пост",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/posts/{{postId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}
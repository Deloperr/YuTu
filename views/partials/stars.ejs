<%# Звёзды рейтинга. Параметры: value (0–5 или null), count (необязательно) %>
<% const r = value ? Math.round(value) : 0; %>
<span class="stars" title="<%= value ? `Средняя оценка ${value} из 5` : 'Оценок пока нет' %>">
  <span class="stars-on"><%= '★'.repeat(r) %></span><span class="stars-off"><%= '★'.repeat(5 - r) %></span>
  <span class="stars-value"><%= value ? value.toFixed(1) : '—' %></span>
  <% if (typeof count !== 'undefined') { %>
    <span class="muted">(<%= count %> <%= plural(count, ['оценка', 'оценки', 'оценок']) %>)</span>
  <% } %>
</span>

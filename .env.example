# MongoDB Atlas: строка из Connect → Drivers, имя базы – yutu
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/yutu?retryWrites=true&w=majority
# Локальная MongoDB (например, docker run -d -p 27017:27017 mongo:7)
# MONGO_URI=mongodb://localhost:27017/yutu
JWT_SECRET=change-me
CLIENT_URL=http://localhost:5173
API_DELAY_MS=0
